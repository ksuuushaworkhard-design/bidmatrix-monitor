EXA_API_KEY=replace_with_your_exa_api_key

# Optional delivery. Leave disabled unless you want reports sent.
BIDMATRIX_DELIVERY_ENABLED=false
BIDMATRIX_DELIVERY_CHANNEL=telegram

# Telegram delivery
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email delivery
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# Resend weekly email delivery
RESEND_API_KEY=
WEEKLY_EMAIL_FROM=BidMatrix <weekly@updates.bid-matrix.com>
WEEKLY_EMAIL_SEGMENT_ID=

# External subscribers use a separate segment. Do not add this to the scheduled
# workflow until the audience has passed consent review and launch is approved.
WEEKLY_EMAIL_EXTERNAL_SEGMENT_ID=
