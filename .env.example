EXA_API_KEY=replace_with_your_exa_api_key

# Optional delivery. Leave disabled unless you want reports sent.
BIDMATRIX_DELIVERY_ENABLED=false
BIDMATRIX_DELIVERY_CHANNEL=telegram

# Telegram delivery
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MESSAGE_THREAD_ID=

# Email delivery
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# Weekly public email (Resend Broadcasts)
RESEND_API_KEY=
WEEKLY_EMAIL_FROM=BidMatrix <weekly@updates.bid-matrix.com>
WEEKLY_EMAIL_REPLY_TO=Ksenia <ksenia@bid-matrix.com>
WEEKLY_EMAIL_SEGMENT_ID=
WEEKLY_EMAIL_PUBLIC_LAUNCH=false
WEEKLY_EMAIL_REQUIRE_APPROVAL=true
WEEKLY_EMAIL_APPROVED=false
WEEKLY_EMAIL_PUBLIC_INTRO_DATE=

# Optional private Google Sheet subscriber sync
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_SUBSCRIBER_RANGE=Newsletter Subscribers!A:C
